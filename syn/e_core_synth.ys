# ---------------------------------------------------------------------------
# Yosys area estimate for the E-Core.
#
# The input is build/synth/e_core_flat.v, produced by sv2v from the
# SystemVerilog sources. Yosys's built-in front end cannot parse enumerated or
# packed-struct types in port lists, which this design uses throughout for
# readability; sv2v lowers them to plain vectors without changing behaviour.
# See scripts/synth_estimate.sh.
#
# Two passes are run:
#   1. generic technology-independent synthesis + stat, giving cell and
#      flip-flop counts that are comparable across tool versions;
#   2. synth_xilinx for the 7-series LUT number that the plan's "< 5K LUTs"
#      target refers to.
# ---------------------------------------------------------------------------

read_verilog build/synth/e_core_flat.v
hierarchy -check -top e_core_top

# --- pass 1: generic ---
proc
opt_expr
opt_clean
check
fsm
opt
memory -nomap
opt_clean
techmap
opt -fast
abc -g cmos2,NAND,NOR,AOI3,OAI3,AOI4,OAI4
opt_clean

tee -o build/synth/generic_stat.txt stat -width

# --- pass 2: Xilinx 7-series LUT estimate ---
design -reset
read_verilog build/synth/e_core_flat.v
hierarchy -check -top e_core_top

synth_xilinx -family xc7 -flatten

tee -o build/synth/xilinx_stat.txt stat -width
